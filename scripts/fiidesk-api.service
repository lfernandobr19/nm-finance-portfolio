[Unit]
Description=NM Finance API (:8010)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/nm-finance-portfolio/backend
EnvironmentFile=%h/Projects/nm-finance-portfolio/backend/.env
ExecStart=%h/Projects/nm-finance-portfolio/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
