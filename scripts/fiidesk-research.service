[Unit]
Description=NM Finance research worker (isolated queue)
After=network-online.target redis.service fiidesk-api.service fiidesk-worker.service
Wants=network-online.target

[Service]
Type=simple
Nice=10
WorkingDirectory=%h/Projects/nm-finance-portfolio/backend
EnvironmentFile=%h/Projects/nm-finance-portfolio/backend/.env
ExecStart=%h/Projects/nm-finance-portfolio/backend/.venv/bin/arq app.workers.arq_settings.ResearchWorkerSettings
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
