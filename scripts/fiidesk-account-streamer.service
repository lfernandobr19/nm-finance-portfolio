[Unit]
Description=NM Finance tastytrade Account Streamer (order fills)
After=network-online.target redis.service fiidesk-api.service fiidesk-worker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/nm-finance-portfolio/backend
EnvironmentFile=%h/Projects/nm-finance-portfolio/backend/.env
ExecStart=%h/Projects/nm-finance-portfolio/backend/.venv/bin/python -m app.workers.tastytrade_account_streamer
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
