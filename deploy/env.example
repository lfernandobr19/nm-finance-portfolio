APP_NAME=NM Finance
ENVIRONMENT=production
SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://fiidesk:fiidesk@127.0.0.1:5432/fiidesk
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=*
MARKET_PROVIDER_URL=
NEWS_FEED_URL=https://news.google.com/rss/search?q=FII+OR+fundos+imobiliarios&hl=pt-BR&gl=BR&ceid=BR:pt-419
PASSWORD_RESET_ECHO=false
# When true, reset code is returned in API JSON (lab only). Default: code only in Ravenna api.log.
FCM_SERVER_KEY=
# Firebase Cloud Messaging legacy server key (deprecated). Kept only for backward compatibility.
# Preferred: HTTP v1 with a service account.
FCM_PROJECT_ID=
# Firebase project ID (e.g. "fiidesk-xxxxx") for FCM v1 messages:send.
FCM_SERVICE_ACCOUNT_JSON=
# JSON string OR absolute path to a Firebase service account key with "Firebase Admin" role.
# Push reaches tokens registered via POST /devices. App-local notifications work without FCM.

# Alpaca (NM High-Vol Dip USD). Leave empty for Yahoo OHLC + alpaca_paper_sim.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# tastytrade (NM USD sandbox). Requires refresh token from OAuth "Create Grant".
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_ACCOUNT_NUMBER=
TASTYTRADE_SANDBOX=true

# HV Dip NM worker
HV_DIP_ENABLED=true
HV_DIP_MIN_INTERVAL_SECONDS=1800
HV_DIP_CACHE_DIR=.cache/alpaca
HV_DIP_TOP_N=10
HV_DIP_DIP_PCT=8.0
HV_DIP_LOOKBACK=10
HV_DIP_HARD_STOP_PCT=12.0
HV_DIP_LIVE_REFRESH_INTERVAL_SECONDS=300
HV_DIP_LIVE_MIN_DIP_PCT=6.0
HV_DIP_APPROVE_SLIPPAGE_PCT=0.5
HV_DIP_EXIT_TRAILING_GIVEBACK_PCT=20
HV_DIP_EXIT_RECOVERY_ENABLED=true
# Exit Engine V2 — LATCHED +5% / PROTECT / dia 14
HV_DIP_EXIT_V2_ENABLED=true
HV_DIP_AUTO_CLOSE_ENABLED=true
HV_DIP_LATCH_PCT=5
HV_DIP_PROTECT_MIN_PCT=8
HV_DIP_PROTECT_USE_ONE_R=true
HV_DIP_PROTECT_GIVEBACK_PCT=2
HV_DIP_PROTECT_MIN_MINUTES=60
HV_DIP_MAX_HOLD_DAYS=14
HV_DIP_REVIEW_EXTENSION_DAYS=3
HV_DIP_ROTATION_SCORE_DELTA=10
# Mean-reversion / oscillation / quality (strategy alignment)
HV_DIP_MIN_DOLLAR_VOLUME=20000000
HV_DIP_MEGA_DOLLAR_VOLUME=200000000
HV_DIP_QUALITY_BONUS=5
HV_DIP_MIN_RECOVERY_RATE=0.6
HV_DIP_OSC_SWING_PCT=8
HV_DIP_OSC_WINDOW=84
HV_DIP_REJECT_FRESH_HIGH=true
# Structural-decline observation (Fase 5b)
HV_DIP_OBS_RECOVERY_MIN_PCT=5
HV_DIP_OBS_PROBABILITY_MIN=0.6
HV_DIP_OBS_RISKY_SIZE_MULT=0.5
# hv_dip learn loop (walk-forward auto-tuning)
HV_DIP_LEARN_ENABLED=true
HV_DIP_LEARN_INTERVAL_SECONDS=86400
HV_DIP_MIN_CLOSED_SIGNALS=30
HV_DIP_LEARN_SIGNIFICANCE=0.05
HV_DIP_LEARN_MIN_MARGIN_PCT=5
HV_DIP_LEARN_CIRCUIT_BREAKER_R=-0.3
DESK_DAILY_PNL_TARGET_PCT=7
DESK_STRETCH_EQUITY_TARGET=130
DESK_STRETCH_AVG_RETURN_PCT=11
DESK_STRETCH_REALIZED_PNL_TARGET=25
# Deprecated — leave empty; phone alerts come from the NM Finance app.
ANDROID_AGENT_URL=
ANDROID_AGENT_TOKEN=
SUGGESTION_SCORE_THRESHOLD=70
BDR_WITHHOLDING_RATE=0.30
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
WORKER_INTERVAL_SECONDS=300
# Swing Desk / brapi (free ~4×/day). Never commit the real token.
BRAPI_TOKEN=
SWING_ENABLED=true
SWING_MIN_INTERVAL_SECONDS=21600
SWING_OHLC_TTL_SECONDS=18000
SWING_CACHE_DIR=.cache/brapi
SWING_TOP_N=10

# Day trade study (US intraday observer — paper only, no auto orders)
DAY_TRADE_ENABLED=false
DAY_TRADE_STREAMER_ENABLED=true
DAY_TRADE_WATCHLIST=SPY,LCID,SNAP,XPEV,AMD,NET,BA,MARA
DAY_TRADE_CANDLE_PERIOD=5m
DAY_TRADE_CACHE_DIR=.cache/day_trade

# NM News catalyst (Finnhub). Never commit the real key.
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
NEWS_US_ENABLED=true
NEWS_CONFIDENCE_MIN=0.7
NEWS_EVENT_WHITELIST=partnership,guidance_up,upgrade,m_and_a,contract,product_launch
NEWS_GAP_FILTER_PCT=5
NEWS_WINDOW_HOURS=12
NEWS_AUTO_BUY_ENABLED=false
NEWS_MAX_NEWS_POSITIONS=2
NEWS_SCORE_BONUS=5
NEWS_MIN_DOLLAR_VOLUME=20000000
NEWS_MIN_PRICE=5

