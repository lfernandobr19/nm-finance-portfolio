[Unit]
Description=NM Finance API (:8010)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/fiidesk/backend
EnvironmentFile=%h/Projects/fiidesk/backend/.env
ExecStartPre=/bin/bash -c 'for i in $(seq 1 90); do (echo > /dev/tcp/127.0.0.1/5432) 2>/dev/null && exit 0; sleep 2; done; exit 1'
ExecStart=%h/Projects/fiidesk/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
